---
import "../styles/global.css";
---

<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="Secure, air-gapped-ready tactical intelligence workstation for local LLM inference, doctrine-aware reasoning, and full data sovereignty." />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    <title>Tactical Intelligence Workstation</title>
    <style>
      :root {
        --accent: #22d3ee;
        --accent-dim: #0e7490;
        --amber: #f59e0b;
        --red: #ef4444;
        --surface: #080f1b;
        --border: #1e2d3d;
        --border-strong: #2d4055;
      }

      body {
        background-color: #030b14;
        color: #cbd5e1;
        font-family: 'IBM Plex Mono', monospace;
      }

      .dot-grid {
        background-image: radial-gradient(circle, #1e2d3d 1px, transparent 1px);
        background-size: 28px 28px;
      }

      .scanlines::after {
        content: '';
        position: absolute;
        inset: 0;
        background: repeating-linear-gradient(
          to bottom,
          transparent,
          transparent 2px,
          rgba(0,0,0,0.06) 2px,
          rgba(0,0,0,0.06) 4px
        );
        pointer-events: none;
        z-index: 1;
      }

      .card-hover {
        transition: border-color 0.25s, box-shadow 0.25s;
      }
      .card-hover:hover {
        border-color: var(--accent-dim);
        box-shadow: 0 0 0 1px #0e749030, inset 0 0 30px #0e749008;
      }

      .sop-step {
        border-left: 2px solid var(--border-strong);
        transition: border-color 0.2s;
      }
      .sop-step:hover { border-left-color: var(--accent); }

      .tag {
        font-size: 9px;
        font-weight: 700;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        padding: 2px 8px;
        border-radius: 2px;
      }

      .glow-text {
        text-shadow: 0 0 24px rgba(34, 211, 238, 0.35);
      }

      /* Screenshot viewer */
      .screenshot-tab { cursor: pointer; transition: all 0.2s; }
      .screenshot-tab.active {
        border-color: var(--accent-dim) !important;
        color: var(--accent) !important;
      }
      .screenshot-panel { display: none; }
      .screenshot-panel.active { display: block; }

      /* Model tier row */
      .tier-row { transition: background 0.15s; }
      .tier-row:hover { background: #0a1626; }

      /* Gradient fade on hero */
      .hero-fade {
        background: linear-gradient(135deg, #030b14 0%, #060e1a 50%, #030b14 100%);
      }

      /* Accent line */
      .accent-line {
        background: linear-gradient(90deg, var(--accent) 0%, transparent 100%);
        height: 1px;
        width: 48px;
      }
    </style>
  </head>

  <body class="antialiased selection:bg-cyan-500 selection:text-slate-950">

    <!-- Classification strip -->
    <div class="bg-amber-950/60 border-b border-amber-900/50 text-amber-400/80 text-[9px] font-bold tracking-widest uppercase text-center py-1 px-4">
      FOR OFFICIAL USE ONLY &nbsp;·&nbsp; FOUO &nbsp;·&nbsp; DISTRIBUTION AUTHORIZED TO OPERATIONAL PERSONNEL ONLY
    </div>

    <!-- Fixed header -->
    <header class="border-b border-[#1e2d3d] bg-[#030b14]/90 backdrop-blur-md fixed top-7 left-0 right-0 z-50">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 flex items-center justify-between h-14">

        <div class="flex items-center gap-5">
          <div class="flex items-center gap-2.5">
            <div class="relative w-2 h-2">
              <span class="absolute inset-0 bg-cyan-400 rounded-full animate-ping opacity-60"></span>
              <span class="absolute inset-0 bg-cyan-400 rounded-full"></span>
            </div>
            <span class="text-[10px] font-bold tracking-[0.2em] text-white uppercase">
              Defence Node <span class="text-cyan-500 mx-1">//</span> Core
            </span>
          </div>
          <div class="hidden sm:flex items-center gap-3 border-l border-[#1e2d3d] pl-5 text-[9px] tracking-widest text-slate-500 uppercase font-medium">
            <span class="text-emerald-400 font-bold">● INFERENCE: LOCAL</span>
            <span class="text-slate-600">|</span>
            <span>TELEMETRY: NONE</span>
            <span class="text-slate-600">|</span>
            <span>SOVEREIGNTY: FULL</span>
          </div>
        </div>

        <div class="flex items-center gap-6">
          <nav class="hidden md:flex items-center gap-6 text-[10px] uppercase tracking-widest text-slate-500 font-medium">
            <a href="#screenshots" class="hover:text-cyan-400 transition-colors duration-150">Screenshots</a>
            <a href="#capabilities" class="hover:text-cyan-400 transition-colors duration-150">Capabilities</a>
            <a href="#models" class="hover:text-cyan-400 transition-colors duration-150">Models</a>
            <a href="#sop" class="hover:text-cyan-400 transition-colors duration-150">SOP</a>
            <a href="#opsec" class="hover:text-cyan-400 transition-colors duration-150">OPSEC</a>
            <a href="#deploy" class="hover:text-cyan-400 transition-colors duration-150">Deploy</a>
          </nav>
          <a href="/" class="text-[10px] border border-[#1e2d3d] bg-[#080f1b] px-3 py-1.5 text-slate-400 hover:border-cyan-700 hover:text-cyan-400 transition-all font-bold tracking-widest uppercase">
            ← Portfolio
          </a>
        </div>
      </div>
    </header>

    <main class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 pt-36 pb-20 space-y-12">

      <!-- ─── HERO ──────────────────────────────────────────────────── -->
      <section class="relative border border-[#1e2d3d] overflow-hidden dot-grid scanlines hero-fade">
        <div class="absolute top-0 left-0 w-10 h-10 border-t-2 border-l-2 border-cyan-500/70"></div>
        <div class="absolute top-0 right-0 w-10 h-10 border-t-2 border-r-2 border-cyan-500/70"></div>
        <div class="absolute bottom-0 left-0 w-10 h-10 border-b-2 border-l-2 border-cyan-500/20"></div>
        <div class="absolute bottom-0 right-0 w-10 h-10 border-b-2 border-r-2 border-cyan-500/20"></div>

        <!-- Subtle glow behind title -->
        <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-96 h-40 bg-cyan-500/5 blur-3xl rounded-full pointer-events-none"></div>

        <div class="relative z-10 border-b border-[#1e2d3d] px-6 sm:px-8 py-2 flex items-center justify-between">
          <div class="flex items-center gap-4">
            <span class="tag bg-cyan-950/60 text-cyan-400 border border-cyan-900/60">System v3.0</span>
            <span class="tag bg-emerald-950/50 text-emerald-400 border border-emerald-900/50">Operational</span>
            <span class="tag bg-slate-800/50 text-slate-400 border border-slate-700/50 hidden sm:inline-block">Hardware-Adaptive</span>
          </div>
          <span class="text-[9px] text-slate-600 tracking-widest hidden sm:block">SYS_ID: TIW-CORE-0041</span>
        </div>

        <div class="relative z-10 p-6 sm:p-10 lg:p-14 space-y-7">
          <div class="space-y-3">
            <div class="text-[9px] font-bold tracking-[0.2em] text-cyan-500 uppercase">
              01 // System Overview
            </div>
            <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight text-white uppercase leading-tight glow-text">
              Tactical Intelligence<br/>Workstation
            </h1>
            <div class="accent-line mt-4"></div>
            <p class="text-[11px] text-slate-500 tracking-widest uppercase mt-3">Air-Gapped Local LLM Infrastructure for Defence Operations</p>
          </div>

          <p class="text-sm text-slate-300 leading-relaxed max-w-2xl font-light">
            A secure, air-gapped-ready intelligence workstation for local analysis of sensitive mission documents using Large Language Models and Retrieval-Augmented Generation — with 100% data sovereignty. Runs on any modern hardware; the application automatically selects the optimal inference model for your system at startup.
          </p>

          <div class="flex flex-wrap gap-3 pt-2">
            <a href="#deploy"
               class="px-5 py-2.5 text-[10px] uppercase font-bold tracking-widest bg-cyan-500 text-slate-950 hover:bg-cyan-400 transition-colors shadow-[0_0_28px_rgba(34,211,238,0.25)]">
              Request Deployment Build
            </a>
            <a href="#screenshots"
               class="px-5 py-2.5 text-[10px] uppercase font-bold tracking-widest border border-[#2d4055] bg-transparent text-slate-300 hover:border-cyan-700 hover:text-cyan-400 transition-all">
              View Screenshots
            </a>
          </div>
        </div>
      </section>

      <!-- ─── SYSTEM METRICS STRIP ──────────────────────────────────── -->
      <div class="grid grid-cols-2 sm:grid-cols-4 border border-[#1e2d3d] divide-x divide-[#1e2d3d] divide-y sm:divide-y-0 bg-[#080f1b]">
        {[
          { label: "Inference Mode",    value: "100% Local",     accent: true  },
          { label: "Cloud Dependency",  value: "Zero",           accent: false },
          { label: "Data Egress",       value: "None",           accent: false },
          { label: "Network Required",  value: "Offline Ready",  accent: false },
        ].map(m => (
          <div class="px-5 py-4">
            <div class="text-[9px] tracking-widest text-slate-600 uppercase mb-1">{m.label}</div>
            <div class={`text-sm font-bold ${m.accent ? "text-cyan-400" : "text-slate-200"}`}>{m.value}</div>
          </div>
        ))}
      </div>

      <!-- ─── SCREENSHOTS ───────────────────────────────────────────── -->
      <section id="screenshots" class="space-y-3">
        <div class="flex items-center justify-between">
          <div class="flex items-center gap-3">
            <span class="text-[9px] font-bold tracking-[0.2em] text-cyan-500 uppercase">02 // System Screenshots</span>
            <span class="tag bg-emerald-950/50 text-emerald-400 border border-emerald-900/50">Live Build</span>
          </div>
        </div>

        <!-- Tab controls -->
        <div class="flex gap-0 border border-[#1e2d3d] bg-[#080f1b] w-fit">
          <button
            id="tab-1"
            class="screenshot-tab active px-5 py-2.5 text-[10px] font-bold tracking-widest uppercase text-slate-400 border-r border-[#1e2d3d] hover:text-cyan-400 transition-colors"
            onclick="switchTab(1)">
            Hardware Profiler
          </button>
          <button
            id="tab-2"
            class="screenshot-tab px-5 py-2.5 text-[10px] font-bold tracking-widest uppercase text-slate-400 hover:text-cyan-400 transition-colors"
            onclick="switchTab(2)">
            Mission Analysis
          </button>
        </div>

        <!-- Screenshot panels -->
        <div class="border border-[#1e2d3d] bg-black overflow-hidden relative">
          <div class="absolute top-0 left-0 right-0 h-px bg-gradient-to-r from-transparent via-cyan-500/40 to-transparent z-10"></div>

          <div id="panel-1" class="screenshot-panel active">
            <div class="border-b border-[#1e2d3d] px-5 py-2 flex items-center justify-between bg-[#080f1b]">
              <span class="text-[9px] text-slate-500 tracking-widest uppercase font-medium">Hardware-Aware Model Selection — On First Launch</span>
              <span class="text-[9px] text-slate-600 tracking-widest">Apple Silicon M-series · 48 GB Unified Memory</span>
            </div>
            <img
              src="/images/tiw-screenshot-1.png"
              alt="System Hardware Profile screen showing CPU, RAM, and GPU detection with recommended model gemma4:26b and model tier selection"
              class="w-full block"
              loading="lazy"
            />
            <div class="bg-[#080f1b] border-t border-[#1e2d3d] px-5 py-3 flex items-start gap-3">
              <span class="text-cyan-500 text-[10px] font-bold tracking-widest uppercase shrink-0 mt-0.5">Note</span>
              <p class="text-[10px] text-slate-500 leading-relaxed">
                On first launch, the system scans CPU, RAM, and GPU and recommends the optimal inference model for your hardware. Accept the recommendation or select a different tier — models are downloaded automatically if not already present.
              </p>
            </div>
          </div>

          <div id="panel-2" class="screenshot-panel">
            <div class="border-b border-[#1e2d3d] px-5 py-2 flex items-center justify-between bg-[#080f1b]">
              <span class="text-[9px] text-slate-500 tracking-widest uppercase font-medium">Live Mission Document Analysis — BLUF Extraction</span>
              <span class="text-[9px] text-slate-600 tracking-widest">Model: gemma4:26b · Op Frost Bite</span>
            </div>
            <img
              src="/images/tiw-screenshot-2.png"
              alt="Defence Node active interface showing a tactical PDF being analysed with BLUF summary, grid coordinates, and key findings extracted"
              class="w-full block"
              loading="lazy"
            />
            <div class="bg-[#080f1b] border-t border-[#1e2d3d] px-5 py-3 flex items-start gap-3">
              <span class="text-cyan-500 text-[10px] font-bold tracking-widest uppercase shrink-0 mt-0.5">Note</span>
              <p class="text-[10px] text-slate-500 leading-relaxed">
                After ingestion the system generates a high-fidelity BLUF summary, extracting grid coordinates, named objectives, risk indicators, and mission discrepancies directly from the source document. All processing is on-device.
              </p>
            </div>
          </div>
        </div>
      </section>

      <!-- ─── CAPABILITY MATRIX ─────────────────────────────────────── -->
      <section id="capabilities" class="space-y-3">
        <div class="text-[9px] font-bold tracking-[0.2em] text-cyan-500 uppercase">03 // Active Capability Matrix</div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-px bg-[#1e2d3d]">
          {[
            {
              id: "CAP-01",
              title: "Hardware-Aware Model Selection",
              status: "Operational",
              body: "On first launch, the app scans your CPU, RAM, and GPU and recommends the optimal inference tier for your hardware. Accept the recommendation or choose a different model. Downloads are handled automatically if the model is not already present."
            },
            {
              id: "CAP-02",
              title: "Deep Text Intelligence",
              status: "Operational",
              body: "Processes large, complex PDF mission documents and delivers high-fidelity BLUF summaries — extracting grid coordinates, risk indicators, and discrepancies. Analysis depth scales automatically with your hardware tier."
            },
            {
              id: "CAP-03",
              title: "Visual Intel Module",
              status: "Operational",
              body: "Powered by Moondream. Analyses imagery including satellite maps, drone feeds, and surveillance photos. Performs object and landmark detection, translating pixel data into a clinical, objective text description — fully on-device."
            },
            {
              id: "CAP-04",
              title: "Dual-Stream Memory (RAG)",
              status: "Operational",
              body: "Two isolated vector stores: an Ephemeral Mission Archive for the current operation and a Persistent Policy KB for permanent MOD doctrine (JSP 383, Rules of Engagement) loaded via /policy ingestion. The AI automatically cross-references tactical plans against policy to surface legal or ethical constraints."
            },
            {
              id: "CAP-05",
              title: "Integrated OPSEC Layer",
              status: "Operational",
              body: "All inference and database communication is bound to loopback 127.0.0.1. Source PDFs and images are overwritten on the physical disk immediately after analysis. Generated SITREPs are securely shredded from the filesystem 60 seconds after creation."
            },
            {
              id: "CAP-06",
              title: "Formal SITREP Export",
              status: "Operational",
              body: "One-command generation of sanitized FPDF situation reports from the current session context. Reports are formatted for formal distribution and automatically purged from local storage 60 seconds post-generation."
            },
          ].map(cap => (
            <div class="p-5 bg-[#080f1b] card-hover border border-transparent space-y-3 group">
              <div class="flex items-start justify-between gap-4">
                <div class="space-y-1">
                  <span class="text-[9px] text-slate-600 tracking-widest">{cap.id}</span>
                  <h3 class="text-xs font-bold text-white uppercase tracking-wider group-hover:text-cyan-400 transition-colors">
                    {cap.title}
                  </h3>
                </div>
                <span class="tag bg-emerald-950/40 text-emerald-500 border border-emerald-900/40 shrink-0">{cap.status}</span>
              </div>
              <p class="text-[11px] text-slate-400 leading-relaxed font-light">{cap.body}</p>
            </div>
          ))}
        </div>
      </section>

      <!-- ─── MODEL TIERS ───────────────────────────────────────────── -->
      <section id="models" class="space-y-3">
        <div class="flex items-center justify-between">
          <div class="text-[9px] font-bold tracking-[0.2em] text-cyan-500 uppercase">04 // Inference Model Tiers</div>
          <span class="tag bg-slate-800/50 text-slate-500 border border-slate-700/50">Auto-Selected at Startup</span>
        </div>

        <div class="border border-[#1e2d3d] bg-[#080f1b] overflow-hidden">
          <div class="overflow-x-auto">
            <table class="w-full text-[10px]">
              <thead>
                <tr class="border-b border-[#1e2d3d] bg-[#060d18]">
                  <th class="text-left text-slate-600 tracking-widest uppercase px-5 py-3 font-medium">Tier</th>
                  <th class="text-left text-slate-600 tracking-widest uppercase px-5 py-3 font-medium">Model</th>
                  <th class="text-left text-slate-600 tracking-widest uppercase px-5 py-3 font-medium">RAM / VRAM</th>
                  <th class="text-left text-slate-600 tracking-widest uppercase px-5 py-3 font-medium">Use Case</th>
                  <th class="text-left text-slate-600 tracking-widest uppercase px-5 py-3 font-medium">Example Hardware</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-[#12202e]">
                <tr class="tier-row">
                  <td class="px-5 py-3.5">
                    <span class="tag bg-cyan-950/60 text-cyan-400 border border-cyan-900/50">High Performance</span>
                  </td>
                  <td class="px-5 py-3.5 text-slate-200 font-medium">gemma4:26b</td>
                  <td class="px-5 py-3.5 text-cyan-400">40 GB+</td>
                  <td class="px-5 py-3.5 text-slate-400">Highest fidelity analysis, complex cross-referencing</td>
                  <td class="px-5 py-3.5 text-slate-500">M3 Max 48GB · RTX 4090</td>
                </tr>
                <tr class="tier-row">
                  <td class="px-5 py-3.5">
                    <span class="tag bg-emerald-950/50 text-emerald-400 border border-emerald-900/40">Strong</span>
                  </td>
                  <td class="px-5 py-3.5 text-slate-200 font-medium">gemma3:12b</td>
                  <td class="px-5 py-3.5 text-slate-300">24 GB+</td>
                  <td class="px-5 py-3.5 text-slate-400">Solid document analysis and RAG reasoning</td>
                  <td class="px-5 py-3.5 text-slate-500">M2 Pro 24GB · RTX 3090</td>
                </tr>
                <tr class="tier-row">
                  <td class="px-5 py-3.5">
                    <span class="tag bg-amber-950/50 text-amber-400 border border-amber-900/40">Moderate</span>
                  </td>
                  <td class="px-5 py-3.5 text-slate-200 font-medium">llama3.1:8b</td>
                  <td class="px-5 py-3.5 text-slate-300">16 GB+</td>
                  <td class="px-5 py-3.5 text-slate-400">Good general performance on standard hardware</td>
                  <td class="px-5 py-3.5 text-slate-500">M1 16GB · RTX 3060 16GB</td>
                </tr>
                <tr class="tier-row">
                  <td class="px-5 py-3.5">
                    <span class="tag bg-slate-800/60 text-slate-400 border border-slate-700/50">Entry</span>
                  </td>
                  <td class="px-5 py-3.5 text-slate-200 font-medium">llama3.2:3b</td>
                  <td class="px-5 py-3.5 text-slate-300">8 GB+</td>
                  <td class="px-5 py-3.5 text-slate-400">Basic querying and summarisation on minimal hardware</td>
                  <td class="px-5 py-3.5 text-slate-500">Any modern laptop · 8GB RAM</td>
                </tr>
              </tbody>
            </table>
          </div>
          <div class="border-t border-[#1e2d3d] px-5 py-3 bg-[#060d18]">
            <p class="text-[9px] text-slate-600 tracking-wide">
              Visual Intel (Moondream) runs in parallel as a dedicated vision model and is not part of the tier selection above. All models are downloaded via Ollama and stored locally.
            </p>
          </div>
        </div>
      </section>

      <!-- ─── STANDARD OPERATING PROCEDURES ────────────────────────── -->
      <section id="sop" class="space-y-3">
        <div class="flex items-center justify-between">
          <div class="text-[9px] font-bold tracking-[0.2em] text-cyan-500 uppercase">05 // Standard Operating Procedures</div>
          <span class="tag bg-slate-800/50 text-slate-500 border border-slate-700/50">Unclassified // Releasable</span>
        </div>

        <div class="border border-[#1e2d3d] bg-[#080f1b] divide-y divide-[#1e2d3d]">

          <div class="grid grid-cols-1 md:grid-cols-12 gap-4 p-6 sop-step pl-8 hover:bg-[#0a1220] transition-colors group">
            <div class="md:col-span-3 space-y-1">
              <div class="text-[9px] text-cyan-600 tracking-widest font-bold">STEP 01</div>
              <div class="text-xs font-bold text-white uppercase tracking-wide group-hover:text-cyan-400 transition-colors">Hardware Profile</div>
            </div>
            <div class="md:col-span-9 text-[11px] text-slate-400 leading-relaxed font-light">
              On first launch the system scans your CPU, RAM, and GPU and presents the recommended inference model for your hardware. Accept the recommendation or select an alternative tier. The chosen model is pulled from Ollama automatically if not already present before inference begins.
            </div>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-12 gap-4 p-6 sop-step pl-8 hover:bg-[#0a1220] transition-colors group">
            <div class="md:col-span-3 space-y-1">
              <div class="text-[9px] text-cyan-600 tracking-widest font-bold">STEP 02</div>
              <div class="text-xs font-bold text-white uppercase tracking-wide group-hover:text-cyan-400 transition-colors">Mission Ingestion</div>
            </div>
            <div class="md:col-span-9 text-[11px] text-slate-400 leading-relaxed font-light">
              Attach mission-specific PDFs via the file upload control. The system indexes each document into the Ephemeral Mission Archive and immediately generates a BLUF summary with grid coordinates, risks, and discrepancies extracted. Source files are shredded from disk upon completion.
            </div>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-12 gap-4 p-6 sop-step pl-8 hover:bg-[#0a1220] transition-colors group">
            <div class="md:col-span-3 space-y-1">
              <div class="text-[9px] text-cyan-600 tracking-widest font-bold">STEP 03</div>
              <div class="text-xs font-bold text-white uppercase tracking-wide group-hover:text-cyan-400 transition-colors">Doctrine Ingestion</div>
            </div>
            <div class="md:col-span-9 space-y-3">
              <p class="text-[11px] text-slate-400 leading-relaxed font-light">
                Populate the Persistent Policy KB with JSPs, ROE cards, or MOD guidance using the <code class="text-cyan-400 bg-slate-950 px-1.5 py-0.5 border border-slate-800 text-[10px]">/policy</code> route token. Policy documents persist across sessions and are never auto-purged.
              </p>
              <div class="bg-slate-950 border border-[#1e2d3d] border-l-2 border-l-cyan-700 px-4 py-3 text-[10px] text-slate-400 font-mono">
                <span class="text-slate-600">INPUT &gt;</span>&nbsp;<span class="text-slate-300">/policy [Attach PDF]</span>
              </div>
            </div>
          </div>

