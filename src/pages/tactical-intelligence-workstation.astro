    <script>
      function switchTab(n: number) {
        document.querySelectorAll('.screenshot-tab').forEach((t, i) => {
          t.classList.toggle('active', i + 1 === n);
        });
        document.querySelectorAll('.screenshot-panel').forEach((p, i) => {
          p.classList.toggle('active', i + 1 === n);
        });
      }
      (window as any).switchTab = switchTab;
